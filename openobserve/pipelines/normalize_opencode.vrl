raw = .

kind = "other"
if raw.openinference_span_kind == "LLM" || raw.gen_ai_operation_name == "chat" {
  kind = "inference"
} else if raw.openinference_span_kind == "TOOL" || raw.gen_ai_operation_name == "execute_tool" {
  kind = "tool"
} else if raw.openinference_span_kind == "AGENT" || raw.gen_ai_operation_name == "invoke_agent" {
  kind = "agent"
} else if raw.gen_ai_operation_name == "embeddings" {
  kind = "embedding"
}

success = null
if raw.span_status == "OK" {
  success = true
} else if raw.span_status == "ERROR" {
  success = false
}

model = null
if exists(raw.llm_model_name) {
  model = raw.llm_model_name
} else if exists(raw.gen_ai_response_model) {
  model = raw.gen_ai_response_model
} else if exists(raw.model) {
  model = raw.model
}

provider = null
if exists(raw.gen_ai_provider_name) {
  provider = raw.gen_ai_provider_name
} else if exists(raw.llm_provider) {
  provider = raw.llm_provider
}

conversation_id = null
if exists(raw.session_id) {
  conversation_id = raw.session_id
} else if exists(raw.gen_ai_conversation_id) {
  conversation_id = raw.gen_ai_conversation_id
}

agent = null
if exists(raw.gen_ai_agent_name) {
  agent = raw.gen_ai_agent_name
} else if exists(raw.agent_name) {
  agent = raw.agent_name
}

tool_name = null
if exists(raw.tool_name) {
  tool_name = raw.tool_name
} else if exists(raw.gen_ai_tool_name) {
  tool_name = raw.gen_ai_tool_name
}

duration_ms = null
if exists(raw.duration) {
  duration_ms = to_float!(raw.duration) / 1000.0
}

. = {
  "_timestamp": raw._timestamp,
  "trace_id": raw.trace_id,
  "span_id": raw.span_id,
  "reference_parent_span_id": raw.reference_parent_span_id,
  "reference_parent_trace_id": raw.reference_parent_trace_id,
  "reference_ref_type": raw.reference_ref_type,
  "operation_name": raw.operation_name,
  "start_time": raw.start_time,
  "end_time": raw.end_time,
  "duration": raw.duration,
  "span_kind": raw.span_kind,
  "span_status": raw.span_status,
  "status_code": raw.status_code,
  "status_message": raw.status_message,
  "service_name": raw.service_name,
  "ai_schema_version": 1,
  "ai_source": "opencode",
  "ai_event_kind": kind,
  "ai_model": model,
  "ai_provider": provider,
  "ai_conversation_id": conversation_id,
  "ai_agent": agent,
  "ai_input_tokens": to_int(raw.llm_token_count_prompt) ?? null,
  "ai_output_tokens": to_int(raw.llm_token_count_completion) ?? null,
  "ai_reasoning_tokens": to_int(raw.llm_token_count_completion_details_reasoning) ?? null,
  "ai_cache_read_tokens": to_int(raw.llm_token_count_prompt_details_cache_read) ?? null,
  "ai_cache_write_tokens": to_int(raw.llm_token_count_prompt_details_cache_write) ?? null,
  "ai_total_tokens": to_int(raw.llm_token_count_total) ?? null,
  "ai_cost_usd": to_float(raw.llm_cost_total) ?? null,
  "ai_tool_name": tool_name,
  "ai_duration_ms": duration_ms,
  "ai_success": success
}

. = compact(., recursive: true)
