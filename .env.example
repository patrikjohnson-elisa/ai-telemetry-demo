# Copy to .env and change the password.
# Load it for the scripts with: uv run --env-file .env scripts/<script>.py
OPENOBSERVE_URL=http://localhost:5080
OPENOBSERVE_USER=root@example.com
OPENOBSERVE_PASSWORD=change-me

